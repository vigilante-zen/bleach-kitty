#!/usr/bin/env python3
"""Read-only checks for the Bleach Kitty setup."""
import argparse
import json
from pathlib import Path
import re
import shutil
import struct
import subprocess
import sys


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    home = Path.home()
    root = home / '.config/fastfetch'
    failures = []

    def report(label, issues):
        if issues:
            failures.extend(issues)
            print('FAIL ' + label)
            for issue in issues:
                print('  ' + issue)
        else:
            print('PASS ' + label)

    def execute(args):
        try:
            result = subprocess.run(args, capture_output=True, text=True, timeout=15)
            return result.returncode, (result.stderr + result.stdout).strip()
        except (OSError, subprocess.TimeoutExpired) as error:
            return 1, str(error)

    tools = ['kitty', 'fish', 'fastfetch', 'btop', 'fzf', 'python3']
    report('Required tools', [name + ' is unavailable' for name in tools if not shutil.which(name)])
    issues = []
    portraits = sorted(p for p in (root / 'portraits').glob('*.png') if p.is_file())
    if not portraits:
        issues.append('No portraits found')
    palettes = {}
    for portrait in portraits:
        name = portrait.stem
        try:
            with portrait.open('rb') as stream:
                header = stream.read(24)
            if (len(header) != 24 or header[:8] != b'\x89PNG\r\n\x1a\n'
                    or header[12:16] != b'IHDR' or not all(struct.unpack('>II', header[16:24]))):
                raise ValueError('invalid PNG header')
        except (OSError, ValueError) as error:
            issues.append(f'{name}: {error}')
        for suffix in ['', '-compact']:
            try:
                config = json.loads((root / f'portrait-themes/{name}{suffix}.jsonc').read_text())
                colors = config['display']['color']
                pair = (colors['title'], colors['keys'])
                if not all(isinstance(c, str) and re.fullmatch(r'#[0-9A-Fa-f]{6}', c) for c in pair):
                    raise ValueError('invalid accent colors')
                if not isinstance(config['modules'], list) or not config['modules']:
                    raise ValueError('no greeting modules')
                if not suffix:
                    palettes[name] = pair
                elif palettes.get(name) != pair:
                    raise ValueError('compact and full accents differ')
            except (OSError, ValueError, KeyError, TypeError) as error:
                issues.append(f'{name}{suffix}: {error}')
        try:
            btop = home / f'.config/btop/portraits/{name}.conf'
            match = re.search(r'^color_theme\s*=\s*"([^"]+)"', btop.read_text(), re.M)
            if not match:
                raise ValueError('monitor has no theme path')
            theme = Path(match[1]).read_text()
            if name in palettes:
                primary, secondary = palettes[name]
                if (f'theme[title]="{primary}"' not in theme
                        or f'theme[hi_fg]="{secondary}"' not in theme):
                    raise ValueError('monitor accents differ from greeting')
        except (OSError, ValueError) as error:
            issues.append(f'{name} monitor: {error}')
    report(f'{len(portraits)} portraits and matching greeting/monitor palettes', issues)
    issues = []
    manga = sorted((root / 'manga').glob('*.png'))
    for image in manga:
        try:
            with image.open('rb') as stream:
                header = stream.read(24)
            if (len(header) != 24 or header[:8] != b'\x89PNG\r\n\x1a\n'
                    or header[12:16] != b'IHDR' or not all(struct.unpack('>II', header[16:24]))):
                raise ValueError('invalid PNG header')
            if not (root / 'portraits' / image.name).is_file():
                raise ValueError('no matching color portrait')
        except (OSError, ValueError) as error:
            issues.append(f'{image.stem}: {error}')
    report(f'{len(manga)} manga art variants', issues)

    if shutil.which('fish'):
        functions = home / '.config/fish/functions'
        files = [p for p in [home / '.config/fish/config.fish'] if p.is_file()]
        files += sorted(functions.glob('bankai-*.fish'))
        files += [functions / name for name in ['fish_prompt.fish', 'fish_title.fish', 'fish_right_prompt.fish']]
        files += sorted((home / '.config/fish/completions').glob('bankai-*.fish'))
        code, output = execute(['fish', '--no-config', '-n', *map(str, files)])
        report('Fish configuration syntax', [output] if code else [])
        script = '''set -g fish_function_path "$argv[1]/.config/fish/functions" $fish_function_path
set -e KITTY_WINDOW_ID
for name in $argv[2..-1]
    bankai-accent "$name"
    printf '%s\\t#%s\\t#%s\\n' "$name" "$bankai_prompt_primary" "$bankai_prompt_secondary"
end'''
        code, output = execute(['fish', '--no-config', '-c', script, '--', str(home), *[p.stem for p in portraits]])
        issues = []
        if code:
            issues.append(output)
        else:
            found = {}
            for line in output.splitlines():
                fields = line.split('\t')
                if len(fields) == 3:
                    found[fields[0]] = tuple(fields[1:])
                else:
                    issues.append('Unexpected palette output: ' + line)
            for name, colors in palettes.items():
                if found.get(name) != colors:
                    issues.append(name + ': prompt accents differ from greeting')
        report('Character prompt accents', issues)
    if shutil.which('kitty'):
        path = str(home / '.config/kitty/kitty.conf')
        script = f'from kitty.config import load_config; bad=[]; load_config({path!r}, accumulate_bad_lines=bad); print(*bad, sep="\\n"); raise SystemExit(bool(bad))'
        code, output = execute(['kitty', '+runpy', script])
        report('Kitty configuration', [output or 'Config check failed'] if code else [])
    issues = []
    for filename, choices in [('greeting-mode', {'auto', 'compact', 'full', 'off'}),
                              ('portrait-art-mode', {'color', 'manga', 'mixed'}),
                              ('shuffle-mode', {'portrait', 'character'}),
                              ('portrait-choice', {'random', *[p.stem for p in portraits]})]:
        path = root / filename
        if path.exists() and path.read_text().strip() not in choices:
            issues.append(filename + ': invalid saved preference')
    report('Saved layout, shuffle, portrait and art preferences', issues)
    print('\n' + ('Setup checks passed.' if not failures else f'{len(failures)} issue(s) found.'))
    return bool(failures)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print('FAIL ' + str(error), file=sys.stderr)
        sys.exit(1)
