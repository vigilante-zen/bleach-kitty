#!/usr/bin/env python3
import os
import sys
from pathlib import Path
if len(sys.argv) > 2:
    sys.exit('Usage: bankai-desktop-restore [snapshot-name]')
name = sys.argv[1] if len(sys.argv) == 2 else '20261019-202424-204727'
os.execv(str(Path.home()/'.local/bin/bankai-desktop-backup'), ['bankai-desktop-backup', 'restore', name])
