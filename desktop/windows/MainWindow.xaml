<Window x:Class="Bankai.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Bankai">
  <Grid Padding="24" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="Bankai" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock Text="Choose your character" Style="{StaticResource SubtitleTextBlockStyle}" />
    </StackPanel>
    <TextBox x:Name="Search" Grid.Row="1" PlaceholderText="Search characters"
        AutomationProperties.Name="Search characters" TextChanged="SearchChanged" />
    <Grid Grid.Row="2" ColumnSpacing="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListView x:Name="Characters" DisplayMemberPath="Title" SelectionMode="Single"
          AutomationProperties.Name="Characters" SelectionChanged="SelectionChanged" />
      <Grid Grid.Column="1" RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
          <Image x:Name="Preview" Stretch="Uniform" ImageFailed="PreviewFailed"
              AutomationProperties.Name="Wallpaper preview" />
        </Border>
        <TextBlock x:Name="CharacterTitle" Grid.Row="1" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock x:Name="CharacterDescription" Grid.Row="2" TextWrapping="Wrap" />
      </Grid>
    </Grid>
    <InfoBar x:Name="Status" Grid.Row="3" IsOpen="True" IsClosable="False"
        Severity="Informational" Title="Windows edition preview"
        Message="Browse characters and wallpapers. Desktop changes, backups, and tray controls are planned." />
  </Grid>
</Window>
