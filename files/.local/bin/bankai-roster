#!/usr/bin/env python3
"""Persistent Bleach shuffle deck and favorites, shared across Kitty shells."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import random
import re
import stat
import sys
import tempfile

ICHIGO = ['ichigo-tybw', 'hollow-mask', 'split-ichigo', 'vasto-lorde', 'dangai-ichigo', 'mugetsu', 'white-ichigo']
CHARACTER_FORMS = {
    'ichigo': ICHIGO,
    'kenpachi': ['kenpachi', 'kenpachi-bankai'],
    'urahara': ['urahara', 'urahara-bankai'],
    'renji': ['renji', 'renji-bankai'],
    'hitsugaya': ['hitsugaya', 'hitsugaya-bankai'],
}
CHARACTER_OWNER = {form: character for character, forms in CHARACTER_FORMS.items() for form in forms}
DISPLAY_NAMES = {
    'ichigo-tybw': 'Ichigo · TYBW True Shikai',
    'kenpachi-bankai': 'Kenpachi · Bankai',
    'nemu': 'Nemu Kurotsuchi',
    'askin': 'Askin Nakk Le Vaar',
    'lille': 'Lille Barro',
    'yachiru': 'Yachiru Kusajishi',

    'jugram': 'Jugram Haschwalth',
    'bazz-b': 'Bazz-B',
    'bambietta': 'Bambietta Basterbine',
    'starrk': 'Coyote Starrk',
    'harribel': 'Tier Harribel',
    'hisagi': 'Shuhei Hisagi',
    'komamura': 'Sajin Komamura',
    'hollow-mask': 'Ichigo · Hollow mask',
    'split-ichigo': 'Ichigo · Half Hollow',
    'vasto-lorde': 'Ichigo · Vasto Lorde',
    'dangai-ichigo': 'Ichigo · Dangai',
    'mugetsu': 'Ichigo · Mugetsu',
    'white-ichigo': 'Ichigo · White',
    'rukia-bankai': 'Rukia · Bankai',
    'urahara-bankai': 'Urahara · Bankai',
    'renji-bankai': 'Renji · True Bankai',
    'hitsugaya-bankai': 'Hitsugaya · Adult Bankai',
    'ulquiorra': 'Ulquiorra · Segunda Etapa',
}
GROUPS = {
    'tybw-forms': ['ichigo-tybw', 'kenpachi-bankai', 'renji-bankai', 'hitsugaya-bankai', 'rukia-bankai', 'urahara-bankai', 'yhwach'],
    'new-arrivals': ['ichigo-tybw', 'kenpachi-bankai', 'nemu', 'askin', 'lille', 'yachiru', 'starrk', 'harribel', 'hisagi', 'komamura', 'jugram', 'bazz-b', 'bambietta'],
    'soul-reapers': ICHIGO + ['kenpachi-bankai', 'urahara-bankai', 'renji-bankai', 'hitsugaya-bankai', 'rukia-bankai', 'renji', 'byakuya', 'urahara', 'yoruichi',
        'hitsugaya', 'kenpachi', 'aizen', 'yamamoto', 'shunsui', 'ukitake', 'unohana',
        'mayuri', 'soi-fon', 'shinji', 'rangiku', 'gin', 'hisagi', 'komamura', 'nemu', 'yachiru'],
    'arrancars': ['ulquiorra', 'grimmjow', 'nelliel', 'starrk', 'harribel'],
    'quincy': ['uryu', 'yhwach', 'jugram', 'bazz-b', 'bambietta', 'askin', 'lille'],
    'human-world': ['orihime', 'chad', 'uryu', 'urahara', 'urahara-bankai', 'yoruichi'],
    'ichigo': ICHIGO,
}


MAX_STATE_FILE_BYTES = 64 * 1024


def read_state_bytes(path, limit=MAX_STATE_FILE_BYTES):
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, 'rb') as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                return None
            data = stream.read(limit + 1)
            return data if len(data) <= limit else None
    except OSError:
        return None


def read_json(path, default):
    data = read_state_bytes(path)
    if data is None:
        return default
    try:
        return json.loads(data)
    except (RecursionError, UnicodeError, ValueError):
        return default


def atomic_write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(value)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def draw_deck(path, pool):
    deck = read_json(path, {})
    if not isinstance(deck, dict):
        deck = {}
    remaining = deck.get('remaining', [])
    if (deck.get('pool') != pool or not isinstance(remaining, list)
            or any(not isinstance(n, str) or n not in pool for n in remaining)
            or len(set(remaining)) != len(remaining)):
        remaining = []
    if not remaining:
        remaining = pool.copy()
        random.SystemRandom().shuffle(remaining)
        if len(remaining) > 1 and remaining[0] == deck.get('last'):
            remaining[0], remaining[1] = remaining[1], remaining[0]
    selected = remaining.pop(0)
    atomic_write(path, json.dumps({'pool': pool, 'remaining': remaining, 'last': selected}) + '\n')
    return selected


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['next', 'list', 'status', 'add', 'remove', 'set', 'use', 'all', 'group', 'groups', 'members', 'shuffle', 'catalog', 'picker-data', 'clear', 'toggle'])
    parser.add_argument('names', nargs='*')
    args = parser.parse_args()
    if args.names and args.action not in ['add', 'remove', 'set', 'group', 'members', 'shuffle', 'toggle']:
        parser.error('This action does not accept portrait names.')
    if args.action == 'group' and (len(args.names) > 1 or
            (args.names and args.names[0] not in ['all', *GROUPS])):
        parser.error('Choose a group: all, ' + ', '.join(GROUPS))
    if args.action == 'members' and (len(args.names) != 1 or args.names[0] not in GROUPS):
        parser.error('Choose a group: ' + ', '.join(GROUPS))
    if args.action == 'shuffle' and (len(args.names) > 1 or
            (args.names and args.names[0] not in ['portrait', 'character'])):
        parser.error('Choose a shuffle style: portrait or character.')
    if args.action == 'toggle' and len(args.names) != 1:
        parser.error('Provide exactly one portrait to toggle.')
    config = Path.home() / '.config/fastfetch'
    portraits = config / 'portraits'
    available = sorted(p.stem for p in portraits.glob('*.png')
                       if p.is_file() and re.fullmatch(r'[a-z0-9-]+', p.stem))
    if args.action == 'catalog':
        records = [(name, DISPLAY_NAMES.get(name, name.replace('-', ' ').title())) for name in available]
        for name, label in sorted(records, key=lambda item: item[1].casefold()):
            print(name + '\t' + label)
        return
    if args.action == 'members':
        print('\n'.join(name for name in available if name in GROUPS[args.names[0]]))
        return
    state = Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'bleach'
    state.mkdir(parents=True, exist_ok=True)
    with (state / 'roster.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        shuffle_file = config / 'shuffle-mode'
        shuffle_data = read_state_bytes(shuffle_file, 128)
        try:
            shuffle = shuffle_data.decode('utf-8').strip() if shuffle_data is not None else 'portrait'
        except UnicodeError:
            shuffle = 'portrait'
        if shuffle not in ['portrait', 'character']:
            shuffle = 'portrait'
        if args.action == 'shuffle':
            if args.names:
                shuffle = args.names[0]
                atomic_write(shuffle_file, shuffle + '\n')
            print('Shuffle: ' + shuffle)
            return
        favorites_file = config / 'portrait-favorites.json'
        favorites = read_json(favorites_file, {})
        if not isinstance(favorites, dict):
            favorites = {}
        saved = favorites.get('portraits', [])
        if not isinstance(saved, list):
            saved = []
        saved = sorted(set(n for n in saved if isinstance(n, str) and n in available))
        enabled = favorites.get('enabled') is True and bool(saved)
        group = favorites.get('group', 'all')
        if not isinstance(group, str) or group not in GROUPS:
            group = 'all'
        grouped = [n for n in available if n in GROUPS.get(group, available)]
        rotation = 'favorites' if enabled else ('all portraits' if group == 'all' else group)
        if args.action == 'picker-data':
            catalog = [{'id': name, 'title': DISPLAY_NAMES.get(name, name.replace('-', ' ').title())}
                       for name in available]
            print(json.dumps({
                'groups': list(GROUPS),
                'members': {name: [portrait for portrait in available
                                   if portrait in members]
                            for name, members in GROUPS.items()},
                'favorites': saved,
                'catalog': catalog,
                'rotation': rotation,
                'shuffle': shuffle,
            }, separators=(',', ':')))
            return
        if args.action == 'groups':
            print('all')
            print('\n'.join(GROUPS))
            return
        if args.action == 'group' and not args.names:
            print('Rotation: ' + rotation)
            print('Groups: all, ' + ', '.join(GROUPS))
            return
        if args.action == 'next':
            pool = saved if enabled else grouped
            if not pool:
                parser.error('No portrait images are available.')
            if shuffle == 'character':
                characters = {}
                for name in pool:
                    character = CHARACTER_OWNER.get(name, name)
                    characters.setdefault(character, []).append(name)
                character = draw_deck(state / 'character-deck.json', sorted(characters))
                forms = characters[character]
                selected = draw_deck(state / ('forms-' + character + '.json'), forms)
            else:
                selected = draw_deck(state / 'shuffle-deck.json', pool)
            path = str(portraits / (selected + '.png'))
            atomic_write(state / 'last-portrait', path + '\n')
            print(path)
            return
        if args.action == 'list':
            if saved:
                print('\n'.join(saved))
            return
        if args.action == 'status':
            print('Rotation: ' + rotation)
            print(f'Favorites saved: {len(saved)}')
            print('Shuffle: ' + shuffle)
            if saved:
                print('\n'.join(saved))
            return
        toggled = None
        if args.action in ['add', 'remove', 'set', 'toggle']:
            if not args.names:
                parser.error('Provide at least one portrait name.')
            unknown = [n for n in args.names if n not in available]
            if unknown:
                parser.error('Unknown portrait: ' + ', '.join(unknown))
            if args.action == 'add':
                saved = sorted(set(saved + args.names))
                enabled = True
            elif args.action == 'set':
                saved = sorted(set(args.names))
                enabled = True
            elif args.action == 'toggle':
                name = args.names[0]
                if name in saved:
                    saved.remove(name)
                    enabled = enabled and bool(saved)
                    toggled = 'Removed favorite: ' + name
                else:
                    saved = sorted(saved + [name])
                    toggled = 'Saved favorite: ' + name
            else:
                saved = [n for n in saved if n not in args.names]
                enabled = enabled and bool(saved)
        elif args.action == 'use':
            if not saved:
                parser.error('Save favorites first with bankai-favorites add <names>.')
            enabled = True
        elif args.action == 'all':
            enabled = False
            group = 'all'
        elif args.action == 'clear':
            saved = []
            enabled = False
        elif args.action == 'group':
            selected_group = args.names[0]
            if selected_group != 'all' and not any(n in available for n in GROUPS[selected_group]):
                parser.error('No installed portraits in this group.')
            group = selected_group
            enabled = False
        if args.action in ['add', 'set', 'use']:
            group = 'all'
        atomic_write(favorites_file, json.dumps({'enabled': enabled, 'portraits': saved, 'group': group}, indent=2) + '\n')
        if args.action in ['add', 'set', 'use', 'all', 'group', 'clear']:
            atomic_write(config / 'portrait-choice', 'random\n')
        if toggled:
            print(toggled)
        print('Rotation: ' + ('favorites' if enabled else ('all portraits' if group == 'all' else group)))
        print(f'Favorites saved: {len(saved)}')


if __name__ == '__main__':
    try:
        main()
    except OSError as error:
        print(f'bankai-roster: {error}', file=sys.stderr)
        sys.exit(1)
